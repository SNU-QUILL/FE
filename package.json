{
  "name": "quill",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:admin": "turbo dev --filter=admin",
    "dev:user": "turbo dev --filter=user",
    "dev:ui": "turbo dev --filter=@repo/ui",
    "build:user": "turbo build --filter=user",
    "build:admin": "turbo build --filter=admin",
    "build:ui": "turbo build --filter=@repo/ui",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "turbo": "^2.11.7"
  },
  "packageManager": "pnpm@8.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "@babel/runtime@<7.26.10": "^7.26.10",
      "ajv@<6.14.0": "^6.14.0",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "browserslist@<4.28.7": "^4.28.7",
      "cookie@<0.7.0": "^0.7.0",
      "flatted@<3.4.2": "^3.4.2",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "nanoid@<3.3.18": "^3.3.18",
      "picomatch@<2.3.2": "^2.3.2",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "postcss@<8.5.23": "^8.5.23",
      "yaml@>=1.0.0 <1.10.3": "^1.10.3",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3"
    }
  }
}
